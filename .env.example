# Copy this file to .env.local for local testing (vercel dev), and add the
# same keys in the Vercel dashboard under Project Settings > Environment
# Variables for the deployed site. Never commit the real .env.local.

# Stripe (Dashboard > Developers > API keys) — use the TEST keys until
# you're ready to charge real cards, then switch to the LIVE ones.
STRIPE_SECRET_KEY=sk_test_...

# Stripe (Dashboard > Developers > Webhooks > your endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (resend.com > API Keys)
RESEND_API_KEY=re_...

# Must be a verified sender on your Resend account. Until you verify your
# own domain on Resend, use onboarding@resend.dev — but note that in that
# mode Resend only delivers to the email on your own Resend account, not to
# real customers. Verify a domain before going live.
FROM_EMAIL=onboarding@resend.dev

# Public URL of the deployed site (no trailing slash). Used to build the
# Stripe success/cancel redirect links.
SITE_URL=https://creative-dist.vercel.app

# Direct download link for the plugin build. Leave unset until the beta
# build is ready — the email will tell buyers a download link is coming
# separately instead of sending a broken one.
DOWNLOAD_URL=
