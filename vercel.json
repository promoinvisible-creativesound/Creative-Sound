{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.creativesound.io"
        }
      ],
      "destination": "https://creativesound.io/",
      "permanent": true
    },
    {
      "source": "/sell-beats.html",
      "destination": "/sell-beats",
      "permanent": true
    },
    {
      "source": "/track-shell.html",
      "destination": "/beats.html",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.creativesound.io"
        }
      ],
      "destination": "https://creativesound.io/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/creative-dist.html",
      "destination": "/creative-dist-2",
      "permanent": true
    },
    {
      "source": "/creative-dist-2.html",
      "destination": "/creative-dist-2",
      "permanent": true
    },
    {
      "source": "/home.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/creative-dist-2",
      "destination": "/creative-dist-2.html"
    },
    {
      "source": "/api/review/file",
      "destination": "/api/tickets?action=review-file"
    },
    {
      "source": "/api/producer/license",
      "destination": "/api/tickets?action=producer-license"
    },
    {
      "source": "/type-beats",
      "destination": "/api/tickets?action=seo-page&kind=hub"
    },
    {
      "source": "/type-beat/:slug",
      "destination": "/api/tickets?action=seo-page&kind=type&slug=:slug"
    },
    {
      "source": "/genre/:slug",
      "destination": "/api/tickets?action=seo-page&kind=genre&slug=:slug"
    },
    {
      "source": "/mood/:slug",
      "destination": "/api/tickets?action=seo-page&kind=mood&slug=:slug"
    },
    {
      "source": "/tag/:slug",
      "destination": "/api/tickets?action=seo-page&kind=tag&slug=:slug"
    },
    {
      "source": "/sitemap-store.xml",
      "destination": "/api/tickets?action=seo-page&kind=sitemap"
    },
    {
      "source": "/api/profile/store",
      "destination": "/api/tickets?action=profile-store"
    },
    {
      "source": "/api/producer/stats",
      "destination": "/api/tickets?action=producer-stats"
    },
    {
      "source": "/api/beats/event",
      "destination": "/api/tickets?action=beats-event"
    },
    {
      "source": "/api/profile/producer-tag",
      "destination": "/api/tickets?action=profile-producer-tag"
    },
    {
      "source": "/api/beats/lyrics",
      "destination": "/api/tickets?action=beats-lyrics"
    },
    {
      "source": "/api/beats/peaks",
      "destination": "/api/tickets?action=beats-peaks"
    },
    {
      "source": "/api/beats/free",
      "destination": "/api/tickets?action=beats-free"
    },
    {
      "source": "/api/messages",
      "destination": "/api/tickets?action=messages"
    },
    {
      "source": "/api/notify",
      "destination": "/api/tickets?action=notify"
    },
    {
      "source": "/api/beats/checkout",
      "destination": "/api/tickets?action=beats-checkout"
    },
    {
      "source": "/api/beats/saved",
      "destination": "/api/tickets?action=beats-saved"
    },
    {
      "source": "/api/account/role",
      "destination": "/api/tickets?action=account-role"
    },
    {
      "source": "/api/producer/file",
      "destination": "/api/tickets?action=producer-file"
    },
    {
      "source": "/api/producer/submit",
      "destination": "/api/tickets?action=producer-submit"
    },
    {
      "source": "/api/producer/submissions",
      "destination": "/api/tickets?action=producer-submissions"
    },
    {
      "source": "/api/review/list",
      "destination": "/api/tickets?action=review-list"
    },
    {
      "source": "/api/review/decide",
      "destination": "/api/tickets?action=review-decide"
    },
    {
      "source": "/api/review/inspect",
      "destination": "/api/tickets?action=review-inspect"
    },
    {
      "source": "/api/producer/chunk",
      "destination": "/api/tickets?action=producer-chunk"
    },
    {
      "source": "/api/review/verify",
      "destination": "/api/tickets?action=review-verify"
    },
    {
      "source": "/api/review/producers",
      "destination": "/api/tickets?action=review-producers"
    },
    {
      "source": "/api/producer/verify-request",
      "destination": "/api/tickets?action=producer-verify-request"
    },
    {
      "source": "/api/beats/catalogue",
      "destination": "/api/tickets?action=beats-catalogue"
    },
    {
      "source": "/api/beats/media",
      "destination": "/api/tickets?action=beats-media"
    },
    {
      "source": "/api/beats/file",
      "destination": "/api/tickets?action=beats-file"
    },
    {
      "source": "/api/profile/me",
      "destination": "/api/tickets?action=profile-me"
    },
    {
      "source": "/api/profile/avatar",
      "destination": "/api/tickets?action=profile-avatar"
    },
    {
      "source": "/api/profile/photo",
      "destination": "/api/tickets?action=profile-photo"
    },
    {
      "source": "/api/profile/public",
      "destination": "/api/tickets?action=profile-public"
    },
    {
      "source": "/api/producer/payouts",
      "destination": "/api/tickets?action=producer-payouts"
    },
    {
      "source": "/api/payouts/run",
      "destination": "/api/tickets?action=payouts-run"
    },
    {
      "source": "/api/producer/tax",
      "destination": "/api/tickets?action=producer-tax"
    },
    {
      "source": "/api/producer/statement",
      "destination": "/api/tickets?action=producer-statement"
    },
    {
      "source": "/api/admin/earnings-export",
      "destination": "/api/tickets?action=earnings-export"
    },
    {
      "source": "/api/payouts/check",
      "destination": "/api/tickets?action=payouts-check"
    },
    {
      "source": "/api/review/tag",
      "destination": "/api/tickets?action=review-tag"
    },
    {
      "source": "/api/beats/license",
      "destination": "/api/tickets?action=beats-license"
    },
    {
      "source": "/sell-beats",
      "destination": "/sell-beats.html"
    },
    {
      "source": "/track.html",
      "destination": "/api/tickets?action=seo-page&kind=track"
    },
    {
      "source": "/@:handle",
      "destination": "/api/tickets?action=seo-page&kind=profile&handle=:handle"
    }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=600"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/payouts/run",
      "schedule": "0 9 * * 1"
    }
  ],
  "functions": {
    "api/tickets.js": {
      "maxDuration": 60,
      "includeFiles": "{artist.html,track-shell.html}"
    }
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
