{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.creativesound.io"
        }
      ],
      "destination": "https://creativesound.io/:path*",
      "permanent": true
    },
    {
      "source": "/creative-dist.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/notify",
      "destination": "/api/tickets?action=notify"
    }
  ]
}
